{
  "name": "@openai/codex-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A production desktop workbench for the Codex CLI.",
  "author": "OpenAI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "clean": "rimraf dist release coverage",
    "dev": "pnpm run build:main && concurrently -k -n renderer,main -c cyan,magenta \"vite --host 127.0.0.1\" \"wait-on tcp:5178 && cross-env CODEX_DESKTOP_DEV_URL=http://127.0.0.1:5178 electron .\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "stage:runtime": "node scripts/stage-runtime.mjs --profile dev-small",
    "stage:runtime:release": "node scripts/stage-runtime.mjs --profile release",
    "test": "vitest run && node --test scripts/release-identity.test.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
