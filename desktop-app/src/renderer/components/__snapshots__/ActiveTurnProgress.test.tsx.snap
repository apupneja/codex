// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ActiveTurnProgress > shows current plan and file progress in a dismissible disclosure 1`] = `
<div
  aria-atomic="true"
  aria-live="polite"
  class="active-turn-progress"
>
  <div
    aria-label="Task progress details"
    class="ui-menu active-turn-progress-popover"
    id="_r_0_"
    role="region"
  >
    <ol
      class="active-turn-progress-steps"
    >
      <li
        class="active-turn-progress-step is-completed"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-circle-check"
          fill="none"
          height="15"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="15"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
          />
          <path
            d="m9 12 2 2 4-4"
          />
        </svg>
        <span>
          Inspect the existing conversation UI
        </span>
      </li>
      <li
        class="active-turn-progress-step is-inProgress"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-loader-circle spin"
          fill="none"
          height="15"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="15"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M21 12a9 9 0 1 1-6.219-8.56"
          />
        </svg>
        <span>
          Implement the active progress surface
        </span>
      </li>
      <li
        class="active-turn-progress-step is-pending"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-circle"
          fill="none"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
          />
        </svg>
        <span>
          Verify light and dark layouts
        </span>
      </li>
    </ol>
  </div>
  <button
    aria-controls="_r_0_"
    aria-expanded="true"
    aria-label="Step 2 of 3, 2 files changed, 3 additions, 1 deletions"
    class="active-turn-progress-trigger"
    title="Implement the active progress surface"
    type="button"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-loader-circle active-turn-progress-spinner spin"
      fill="none"
      height="16"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="16"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M21 12a9 9 0 1 1-6.219-8.56"
      />
    </svg>
    <span
      class="active-turn-progress-label"
    >
      Step 
      2
       / 
      3
    </span>
    <span
      aria-hidden="true"
      class="active-turn-progress-divider"
    >
      ·
    </span>
    <span
      class="active-turn-progress-files"
    >
      2 files changed
    </span>
    <b
      class="addition"
    >
      +
      3
    </b>
    <b
      class="deletion"
    >
      −
      1
    </b>
  </button>
</div>
`;
