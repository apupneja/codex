exports[`keeps side-panel tabs while opening the extracted new-tab menu 2`] = `
<div
  aria-labelledby="side-chat-close-title"
  aria-modal="true"
  class="side-chat-close-dialog"
  role="dialog"
>
  <h2
    id="side-chat-close-title"
  >
    Close side chat?
  </h2>
  <p>
    This side chat will be gone and can’t be recovered. Are you sure?
  </p>
  <label>
    <input
      type="checkbox"
    />
    <span>
      Don’t ask again
    </span>
  </label>
  <div
    class="side-chat-close-dialog__actions"
  >
    <button
      type="button"
    >
      Cancel
    </button>
    <button
      class="is-danger"
      type="button"
    >
      Close side chat
    </button>
  </div>
</div>
`;

exports[`loads persisted SQLite chats into their sidebar project 1`] = `
<section
  class="sidebar-section sidebar-section--projects"
>
  <header>
    <button
      aria-expanded="true"
      class="sidebar-section__toggle"
      type="button"
    >
      <span>
        Projects
      </span>
      <svg
        aria-hidden="true"
        fill="none"
        viewBox="0 0 20 21"
      >
        <path
          d="M15.2793 7.71101C15.539 7.45131 15.961 7.45131 16.2207 7.71101C16.4804 7.97071 16.4804 8.39272 16.2207 8.65242L10.4707 14.4024C10.211 14.6621 9.78902 14.6621 9.52932 14.4024L3.77932 8.65242L3.69436 8.54792C3.52385 8.28979 3.55205 7.93828 3.77932 7.71101C4.00659 7.48374 4.3581 7.45554 4.61623 7.62605L4.72073 7.71101L10 12.9903L15.2793 7.71101Z"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="0.6"
        />
      </svg>
    </button>
    <span
      class="sidebar-section__actions"
    >
      <span
        class="sidebar-options-anchor"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="Project sidebar options"
          class="icon-button icon-button--sm "
          title="Project sidebar options"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-ellipsis"
            fill="none"
            height="24"
