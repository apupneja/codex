exports[`opens and persists the extracted General setting menus 1`] = `
<div
  class="settings-dropdown__menu is-searchable"
  role="dialog"
>
  <label
    class="settings-dropdown__search"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-search"
      fill="none"
