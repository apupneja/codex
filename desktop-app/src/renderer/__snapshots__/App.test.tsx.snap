exports[`edits the latest user message in the extracted inline editor 1`] = `
<form
  class="user-message-editor"
>
  <textarea
    aria-label="Edit message"
    placeholder="Edit message"
    rows="2"
  >
    Fix the parser
  </textarea>
  <div
    class="user-message-editor__actions"
  >
    <button
      type="button"
    >
      Cancel
    </button>
    <button
      class="is-primary"
      type="submit"
    >
      Send
    </button>
  </div>
</form>
`;

