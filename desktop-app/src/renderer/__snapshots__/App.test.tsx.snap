// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`adds a project and saves the extracted local environment editor 1`] = `
<div
  class="settings-content settings-content--route settings-content--described environment-editor"
>
  <button
    class="environment-editor__back"
    type="button"
  >
    <svg
      class="lucide lucide-chevron-left"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="m15 18-6-6 6-6"
      />
    </svg>
     Back
  </button>
  <header
    class="settings-route-header"
  >
    <div>
      <h1>
        Edit local environment
      </h1>
    </div>
  </header>
  <section
    class="settings-route-section"
  >
    <div
      class="settings-route-section__header"
    >
      <div>
        <strong>
          Setup script
        </strong>
      </div>
      <div
        class="environment-variables-trigger"
      >
        <button
          aria-label="Variables"
          class="settings-route-button"
          type="button"
        >
          Variables
        </button>
      </div>
    </div>
    <textarea
      aria-label="Setup script"
      class="settings-route-textarea environment-editor__script"
      placeholder="For example: npm install"
      rows="6"
    />
  </section>
  <section
    class="environment-editor__advanced"
  >
    <button
      aria-expanded="false"
      type="button"
    >
      <svg
        class="lucide lucide-chevron-down"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="m6 9 6 6 6-6"
        />
      </svg>
       Advanced options
    </button>
  </section>
  <div
    class="environment-editor__footer"
  >
    <button
      class="settings-route-button is-primary"
      disabled=""
      type="button"
    >
      Set up project
    </button>
  </div>
</div>
`;

exports[`adds a project and saves the extracted local environment editor 2`] = `
<div
  aria-label="Setup script environment variables"
  class="environment-variables-popover"
  role="dialog"
  style="left: 8px; top: 6px;"
>
  <strong>
    Setup script environment variables
  </strong>
  <div>
    <span>
      Source workspace path
    </span>
    <code>
      CODEX_SOURCE_TREE_PATH
    </code>
  </div>
  <div>
    <span>
      New worktree path
    </span>
    <code>
      CODEX_WORKTREE_PATH
    </code>
  </div>
</div>
`;

exports[`captures, persists, and clears keyboard shortcut bindings 1`] = `
<div
  class="shortcut-capture"
>
  <input
    aria-label="Shortcut capture for New chat"
    readonly=""
    value="Press shortcut"
  />
  <button
    type="button"
  >
    Cancel
  </button>
</div>
`;

