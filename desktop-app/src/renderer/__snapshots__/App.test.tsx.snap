exports[`reproduces the extracted Plugins, Skills, marketplace, and MCP flows 3`] = `
<section
  aria-labelledby="plugin-marketplace-title"
  class="plugins-marketplace-dialog"
  role="dialog"
>
  <form
    class="plugins-marketplace-dialog__form"
  >
    <h2
      class="visually-hidden"
      id="plugin-marketplace-title"
    >
      Add plugin marketplace
    </h2>
    <div
      class="plugins-marketplace-dialog__section plugins-marketplace-dialog__header"
    >
      <div
        class="plugins-marketplace-dialog__title"
      >
        Add plugin marketplace
      </div>
      <div
        class="plugins-marketplace-dialog__description"
      >
        Add from a GitHub repo, Git URL, or local folder.
         
        <a
          href="https://developers.openai.com/codex/plugins/build"
        >
          Learn more
        </a>
      </div>
    </div>
    <div
      class="plugins-marketplace-dialog__section plugins-marketplace-dialog__fields"
    >
      <label
        for="plugin-marketplace-source"
      >
        Source
        <input
          aria-invalid="false"
          id="plugin-marketplace-source"
          placeholder="openai/plugins or git@github.com:org/repo.git"
          value=""
        />
      </label>
      <label
        for="plugin-marketplace-ref"
      >
        Git ref
        <input
          id="plugin-marketplace-ref"
          placeholder="main"
          value=""
        />
      </label>
      <label
        for="plugin-marketplace-sparse-paths"
      >
        Sparse paths
        <textarea
          id="plugin-marketplace-sparse-paths"
          placeholder="plugins/codex"
        />
      </label>
    </div>
    <div
      class="plugins-marketplace-dialog__section"
    >
      <div
        class="plugins-marketplace-dialog__actions"
      >
        <button
          type="button"
        >
          Cancel
        </button>
        <button
          disabled=""
          type="submit"
        >
          Add marketplace
        </button>
      </div>
    </div>
  </form>
  <button
    class="plugins-marketplace-dialog__close"
    type="button"
  >
