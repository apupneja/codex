exports[`reproduces the extracted Plugins settings Add menu and destinations 1`] = `
<div
  class="plugins-settings__add-menu"
  role="menu"
>
  <button
    role="menuitem"
    type="button"
  >
    <svg
      aria-hidden="true"
      fill="none"
      viewBox="0 0 16 16"
    >
