        class="settings-route-row"
      >
        <div
          class="settings-route-row__copy"
        >
          <strong>
            Diff markers
          </strong>
          <span>
            Show changes using colors or +/− markers
          </span>
        </div>
        <div
          class="settings-route-row__action"
        >
          <div
            class="preference-segment"
          >
            <button
              aria-label="Color diff markers"
              class="is-active"
              type="button"
            >
              Color
            </button>
            <button
              aria-label="Plus / minus diff markers"
              class=""
              type="button"
            >
              +/-
            </button>
          </div>
        </div>
      </div>
      <div
        class="settings-route-row"
      >
        <div
          class="settings-route-row__copy"
        >
          <strong>
            Font smoothing
          </strong>
          <span>
            Use native macOS font anti-aliasing
          </span>
        </div>
        <div
          class="settings-route-row__action"
        >
          <button
            aria-checked="true"
            aria-label="Font smoothing"
            class="settings-route-switch"
            role="switch"
            type="button"
          >
            <span />
          </button>
        </div>
      </div>
    </div>
  </section>
</div>
`;

