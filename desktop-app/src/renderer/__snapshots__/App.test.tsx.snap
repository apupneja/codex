exports[`matches the extracted empty Projects index 1`] = `
<main
  class="projects-index-page"
>
  <div
    class="projects-index-page__layout"
  >
    <header
      class="projects-index-page__header"
    >
      <h1>
        Projects
      </h1>
      <p>
        Create a project to organize chats and give ChatGPT access to folders on your computer.
      </p>
    </header>
    <div
      class="projects-index-page__empty"
    >
      <button
        class="projects-index-page__new"
        type="button"
      >
        New project
      </button>
    </div>
  </div>
</main>
`;

exports[`matches the extracted image-picker-only OpenAI form 1`] = `
<section
  class="openai-form-card openai-form-card--image-only"
  data-codex-approval-surface="true"
>
  <form>
    <div
      class="openai-form-card__fields"
    >
      <div
        class="openai-image-picker"
      >
        <div
          class="openai-image-picker__content"
        >
          <div
            class="openai-image-picker__header"
          >
            <div>
              Choose a template
            </div>
            <button
              aria-label="Show previous templates"
              disabled=""
              title="Show previous templates"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="is-reversed"
                fill="none"
                viewBox="0 0 20 20"
              >
                <path
                  d="M7.529 3.779a.667.667 0 0 1 .941 0l5.75 5.75a.667.667 0 0 1 0 .942l-5.75 5.75a.667.667 0 0 1-.941-.942L12.808 10 7.529 4.721a.667.667 0 0 1 0-.942Z"
                  fill="currentColor"
                />
              </svg>
            </button>
            <button
              aria-label="Show more templates"
              disabled=""
              title="Show more templates"
              type="button"
            >
              <svg
                aria-hidden="true"
                fill="none"
                viewBox="0 0 20 20"
              >
                <path
                  d="M7.529 3.779a.667.667 0 0 1 .941 0l5.75 5.75a.667.667 0 0 1 0 .942l-5.75 5.75a.667.667 0 0 1-.941-.942L12.808 10 7.529 4.721a.667.667 0 0 1 0-.942Z"
                  fill="currentColor"
                />
              </svg>
            </button>
          </div>
          <div
            aria-label="Choose a template"
            class="openai-image-picker__options"
            role="radiogroup"
          >
            <label>
              <input
                name="template"
                type="radio"
                value="minimal"
              />
              <div
                class="openai-image-picker__image"
              >
                <img
                  alt=""
                  decoding="async"
                  draggable="false"
                  loading="lazy"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Wl2nGQAAAAASUVORK5CYII="
                />
              </div>
              <div
                class="openai-image-picker__item-title"
              >
                Minimal
              </div>
            </label>
            <label>
              <input
                name="template"
                type="radio"
                value="editorial"
              />
              <div
                class="openai-image-picker__image"
              >
                <img
                  alt=""
                  decoding="async"
                  draggable="false"
                  loading="lazy"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Wl2nGQAAAAASUVORK5CYII="
                />
              </div>
              <div
                class="openai-image-picker__item-title"
              >
                Editorial
              </div>
            </label>
            <label>
              <input
                name="template"
                type="radio"
                value="bold"
              />
              <div
                class="openai-image-picker__image"
              >
                <img
                  alt=""
                  decoding="async"
                  draggable="false"
                  loading="lazy"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Wl2nGQAAAAASUVORK5CYII="
                />
              </div>
              <div
                class="openai-image-picker__item-title"
              >
                Bold
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>
    <footer
      class="openai-form-card__footer"
    >
      <button
        class="openai-form-card__dismiss"
        type="button"
      >
        <span>
          Dismiss
        </span>
        <kbd
          aria-hidden="true"
        >
          ESC
        </kbd>
      </button>
      <button
        class="openai-form-card__continue"
        disabled=""
        type="submit"
      >
        Continue
      </button>
    </footer>
  </form>
</section>
`;

