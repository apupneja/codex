exports[`opens and returns from the extracted open-source licenses route 1`] = `
<div
  class="settings-content settings-open-source-licenses"
>
  <header>
    <h1>
      Open source licenses
    </h1>
    <p>
      Third-party notices for dependencies included in this app
    </p>
  </header>
  <section>
    No third-party notices were found.
  </section>
</div>
`;

