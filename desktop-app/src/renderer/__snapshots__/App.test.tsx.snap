exports[`matches and skips an unsupported extracted OpenAI form 1`] = `
<section
  class="openai-form-unsupported"
  data-codex-approval-surface="true"
>
  <div
    class="openai-form-unsupported__body"
  >
    <div>
      This version of ChatGPT can’t show this request yet
    </div>
    <div>
      design-tools
       requested this form. You can skip it and keep going, or dismiss the request
    </div>
  </div>
  <div
    class="openai-form-unsupported__footer"
  >
    <button
      type="button"
    >
      Dismiss
    </button>
    <button
      type="button"
    >
      Skip
    </button>
  </div>
</section>
`;

exports[`matches the Work surface controls and Temporary Chat flow 1`] = `
<main
  aria-label="Main content"
  class="new-task-page work-task-page"
>
  <div
    class="new-task-page__center work-task-page__center"
  >
    <h1>
      What should we work on?
    </h1>
    <div
      class="work-home-composer-region"
    >
      <div
        class="composer composer--work-home"
      >
        <textarea
          aria-label="Work with ChatGPT"
          placeholder="Work with ChatGPT"
          rows="1"
          style="height: 0px;"
        />
        <div
          class="codex-composer-footer"
        >
          <div
            class="codex-composer-footer__left"
          >
            <button
              aria-expanded="false"
              aria-haspopup="menu"
              aria-label="Add files and more"
              class="codex-composer-icon-button"
              type="button"
            >
              <svg
                aria-hidden="true"
                fill="none"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9.33496 16.5V10.665H3.5C3.13273 10.665 2.83496 10.3673 2.83496 10C2.83496 9.63273 3.13273 9.33496 3.5 9.33496H9.33496V3.5C9.33496 3.13273 9.63273 2.83496 10 2.83496C10.3673 2.83496 10.665 3.13273 10.665 3.5V9.33496H16.5L16.6338 9.34863C16.9369 9.41057 17.165 9.67857 17.165 10C17.165 10.3214 16.9369 10.5894 16.6338 10.6514L16.5 10.665H10.665V16.5C10.665 16.8673 10.3673 17.165 10 17.165C9.63273 17.165 9.33496 16.8673 9.33496 16.5Z"
                  fill="currentColor"
                />
              </svg>
            </button>
            <button
              aria-expanded="false"
              aria-haspopup="menu"
              class="codex-composer-control"
              type="button"
            >
              <svg
                aria-hidden="true"
                fill="none"
                viewBox="0 0 20 20"
